{{ 'wallet-studio.css' | asset_url | stylesheet_tag }}
<script src="{{ 'wallet-studio-commerce.js' | asset_url }}" defer></script>
{% assign ws_product = section.settings.wallet_product %}
{% if ws_product == blank %}{% assign ws_product = all_products['wallet-studio'] %}{% endif %}
{% assign ws_variant = ws_product.selected_or_first_available_variant %}
<div class="ws-site" id="wallet-studio">
  <a class="ws-skip" href="#ws-main">Saltar al contenido</a>
  <header class="ws-navigation">
    <div class="ws-wrap ws-nav-inner">
      <a class="ws-wordmark" href="#wallet-studio" aria-label="Wallet Studio, inicio">
        <img class="ws-brand-logo" src="{{ 'wallet-studio-official-logo.png' | file_url }}" width="36" height="36" alt="">
        <span>WALLETSTUDIO<span class="ws-wordmark-dot">.</span>SITE</span>
      </a>
      <nav class="ws-desktop-nav" aria-label="Navegación principal">
        <a href="#ws-designs">Diseños</a>
        <a href="#ws-process">Cómo funciona</a>
        <a href="#ws-faq">Preguntas frecuentes</a>
      </nav>
      <details class="ws-mobile-menu">
        <summary aria-label="Abrir menú de navegación"><span class="ws-mobile-menu-icon" aria-hidden="true"><i></i><i></i><i></i></span><span class="ws-mobile-menu-text">Menú</span></summary>
        <nav class="ws-mobile-menu-panel" aria-label="Navegación móvil">
          <a href="#ws-designs"><span>02</span> Explorar diseños <span aria-hidden="true">↗</span></a>
          <a href="#ws-process"><span>03</span> Cómo funciona <span aria-hidden="true">↗</span></a>
          <a href="#ws-faq"><span>06</span> Preguntas frecuentes <span aria-hidden="true">↗</span></a>
          <a href="#ws-purchase" class="ws-mobile-menu-highlight">Recibir novedades <span aria-hidden="true">↗</span></a>
        </nav>
      </details>
      <a class="ws-nav-cta ws-nav-cart" href="{{ routes.cart_url }}" aria-label="Ver carrito"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 3h2l2.4 11.4a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 2-1.6L21 7H6"/><circle cx="10" cy="21" r="1"/><circle cx="18" cy="21" r="1"/></svg></a>
    </div>
  </header>
    <script>
      (() => {
        const menu = document.querySelector('.ws-mobile-menu');
        if (!menu) return;
        menu.querySelectorAll('a[href^="#"]').forEach(link => {
          link.addEventListener('click', () => menu.removeAttribute('open'));
        });
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && menu.open) {
            menu.open = false;
            menu.querySelector('summary')?.focus();
          }
        });
      })();
    </script>
  <main id="ws-main">
    <section class="ws-hero" aria-labelledby="ws-hero-heading">
      <div class="ws-hero-glow" aria-hidden="true"></div>
      <div class="ws-wrap ws-hero-layout">
        <div class="ws-hero-copy">
          <div class="ws-eyebrow"><span class="ws-signal"></span>{{ section.settings.eyebrow | escape }}</div>
          <h1 id="ws-hero-heading">Tu tarjeta.<br><em>Tu estilo.</em></h1>
          <p class="ws-hero-description">{{ section.settings.hero_description | escape }}</p>
          <div class="ws-hero-actions">
            <a href="#ws-designs" class="ws-button ws-button-primary">Explorar diseños <span aria-hidden="true">↓</span></a>
            <a href="#ws-process" class="ws-text-link">Así funciona <span aria-hidden="true">↓</span></a>
          </div>
          <div class="ws-proof"><span class="ws-proof-line"></span> WINDOWS SOFTWARE <span class="ws-proof-divider"></span> ONE-TIME PAYMENT</div>
        </div>
        <div class="ws-hero-aside">
          <div class="ws-hero-product" aria-label="Dos diseños de tarjeta; pulsa uno para verlo ampliado">
            <div class="ws-ambient-orbit ws-ambient-orbit-a" aria-hidden="true"></div>
            <div class="ws-ambient-orbit ws-ambient-orbit-b" aria-hidden="true"></div>
            <button type="button" class="ws-card ws-card-back ws-card--photo ws-zoom-trigger" data-ws-zoom-src="https://cdn.shopify.com/s/files/1/1034/6607/4441/files/wallet-studio-ws-053-fullbleed-20261022.png?v=1792657545" data-ws-zoom-title="Marble & Gold" aria-label="Ampliar la tarjeta Marble & Gold">
              <img src="https://cdn.shopify.com/s/files/1/1034/6607/4441/files/wallet-studio-ws-053-fullbleed-20261022.png?v=1792657545" alt="Tarjeta blanca de mármol con detalles dorados" width="1488" height="925" loading="eager" decoding="async">
            </button>
            <button type="button" class="ws-card ws-card-front ws-card--photo ws-zoom-trigger" data-ws-zoom-src="https://cdn.shopify.com/s/files/1/1034/6607/4441/files/wallet-studio-ws-056-fullbleed-20261022.png?v=1792657594" data-ws-zoom-title="Black & Gold" aria-label="Ampliar la tarjeta Black & Gold">
              <img src="https://cdn.shopify.com/s/files/1/1034/6607/4441/files/wallet-studio-ws-056-fullbleed-20261022.png?v=1792657594" alt="Tarjeta negra con motivos ornamentales dorados" width="1481" height="925" loading="eager" fetchpriority="high" decoding="async">
            </button>
            <div class="ws-floating-label"><span class="ws-label-dot"></span> YOUR WALLET. REIMAGINED.</div>
            <p class="ws-mockup-caption">Toca una tarjeta para ampliarla.</p>
          </div>
          <div class="ws-hero-cart" id="ws-purchase" aria-label="Compra de Wallet Studio">
            <div class="ws-hero-cart-heading"><span>WALLET STUDIO · WINDOWS</span><strong>{% if ws_product != blank %}{{ ws_product.price | money }}{% else %}6,99 €{% endif %}</strong></div>
            {% if ws_product != blank and ws_variant.available and section.settings.enable_cart %}
              {% form 'product', ws_product, id: 'WalletStudioHeroCartForm', class: 'ws-shopify-cart-form' %}
                <input type="hidden" name="id" value="{{ ws_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" name="add" class="ws-button ws-button-primary ws-hero-buy" data-ws-cart-submit>Añadir al carrito · {{ ws_variant.price | money }} <span aria-hidden="true">↗</span></button>
                <p class="ws-cart-error" data-ws-cart-error role="alert" hidden></p>
                {% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}
              {% endform %}
              <a class="ws-hero-cart-link" href="{{ routes.cart_url }}">Ver carrito y finalizar compra ↗</a>
            {% else %}
              <button type="button" class="ws-button ws-button-primary ws-hero-buy" disabled aria-disabled="true">Añadir al carrito · Próximamente <span aria-hidden="true">↗</span></button>
