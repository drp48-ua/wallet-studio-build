{% doc %}
Renders the automatic artwork showcase and full catalogue link.
@param {string} section_index - Position in the landing page sequence.
{% enddoc %}
{{ 'ws-library.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ws-library.js' | asset_url }}" defer></script>
<section class="ws-library-showcase" data-ws-library data-ws-autoplay aria-labelledby="ws-library-title">
  <div class="ws-wrap"><div class="ws-library-heading"><div><p class="ws-section-index">{{ section_index | escape }} / {{ 'wallet_studio.catalog.eyebrow' | t }}</p><h2 id="ws-library-title">{{ 'wallet_studio.catalog.heading' | t }}</h2><p>{{ 'wallet_studio.catalog.description' | t }}</p></div><span class="ws-library-resolution">1536 × 969 · 2K</span></div></div>
  <div class="ws-library-track" data-ws-library-track tabindex="0" role="region" aria-roledescription="{{ 'wallet_studio.catalog.carousel' | t | escape }}" aria-label="{{ 'wallet_studio.catalog.heading' | t | escape }}">
{% render 'ws-library-card', design_id: 'ws-003', title: 'Reactor carmesí', src: 'https://cdn.shopify.com/s/files/1/1034/6607/4441/files/wallet-studio-library-ws-003-2k.png?v=1792618136', eager: true %}
{% render 'ws-library-card', design_id: 'ws-010', title: 'Dragón oceánico', src: 'https://cdn.shopify.com/s/files/1/1034/6607/4441/files/wallet-studio-library-ws-010-2k.png?v=1792618193' %}
{% render 'ws-library-card', design_id: 'ws-018', title: 'BMW · Medianoche', src: 'https://cdn.shopify.com/s/files/1/1034/6607/4441/files/wallet-studio-library-ws-018-2k.png?v=1792618311' %}
{% render 'ws-library-card', design_id: 'ws-023', title: 'Lamborghini · Villa', src: 'https://cdn.shopify.com/s/files/1/1034/6607/4441/files/wallet-studio-library-ws-023-2k.png?v=1792618349' %}
{% render 'ws-library-card', design_id: 'ws-035', title: 'Máscara imperial', src: 'https://cdn.shopify.com/s/files/1/1034/6607/4441/files/wallet-studio-library-ws-035-2k.png?v=1792618441' %}
{% render 'ws-library-card', design_id: 'ws-045', title: 'GT · Montaña', src: 'https://cdn.shopify.com/s/files/1/1034/6607/4441/files/wallet-studio-library-ws-045-2k.png?v=1792618641' %}
{% render 'ws-library-card', design_id: 'ws-051', title: 'Sakura Fuji plata', src: 'https://cdn.shopify.com/s/files/1/1034/6607/4441/files/wallet-studio-ws-051-fullbleed-20261022.png?v=1792657500' %}
{% render 'ws-library-card', design_id: 'ws-056', title: 'Clásica negra y oro', src: 'https://cdn.shopify.com/s/files/1/1034/6607/4441/files/wallet-studio-ws-056-fullbleed-20261022.png?v=1792657594' %}
  </div><div class="ws-wrap"><div class="ws-library-actions"><a class="ws-button ws-button-primary" href="{{ routes.root_url | append: '/pages/biblioteca' | replace: '//', '/' }}">{{ 'wallet_studio.catalog.all' | t }} <span aria-hidden="true">↗</span></a></div><p class="ws-library-note">{{ 'wallet_studio.catalog.note' | t }}</p></div>
<dialog class="ws-library-dialog" data-ws-library-dialog aria-label="{{ 'wallet_studio.catalog.enlarged' | t | escape }}"><button type="button" class="ws-library-close" data-ws-library-close aria-label="{{ 'wallet_studio.catalog.close' | t | escape }}">×</button><img data-ws-library-image alt="" width="1536" height="969"><p data-ws-library-caption></p></dialog>
</section>


