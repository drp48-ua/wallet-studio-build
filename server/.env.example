# Copy to .env ON THE SERVER; never commit real values.
# Generate independent random secrets with at least 32 bytes each.
WALLET_AUTH_SECRET=
SHOPIFY_SHOP_DOMAIN=store-09240616prrz2-itsdpkjq.myshopify.com
# Exact paid Wallet Studio product IDs, comma separated; no other products qualify.
SHOPIFY_PRODUCT_IDS=10459984298313
# Signing secret for the installed Shopify app / configured webhook subscriptions.
SHOPIFY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# 1 for a 512 MB host; default 4 on larger hosts. Valid values: 1, 2, 3, 4.
WALLET_MAX_CONCURRENT_REQUESTS=1

# Free Render must use remote persistence; no SQLite/ephemeral fallback.
WALLET_STORAGE_MODE=remote
# Supabase dashboard Connect -> Transaction pooler (IPv4, port 6543).
# URL-encode special password characters. TLS verify-full is forced by server.
DATABASE_URL=
DATABASE_SSL_ROOT_CERT=/etc/ssl/certs/ca-certificates.crt
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=wallet-originals
# HTTPS email API for Render Free (SMTP ports are blocked there).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Wallet Studio
